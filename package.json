{
  "name": "soic-knowledge-vault",
  "version": "1.0.0",
  "description": "Structured Reference Engine for SOIC TVGP Investing Framework",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=8192 node_modules/vitepress/bin/vitepress.js dev",
    "docs:dev": "node --max-old-space-size=8192 node_modules/vitepress/bin/vitepress.js dev",
    "docs:build": "node --max-old-space-size=8192 node_modules/vitepress/bin/vitepress.js build",
    "docs:preview": "vitepress preview",
    "sync": "node scripts/sync.js && node scripts/parse_transcripts.js && node scripts/linkify_reports.js",
    "parse:transcripts": "node scripts/parse_transcripts.js",
    "linkify": "node scripts/linkify_reports.js",
    "build": "npm run sync && npm run docs:build"
  },
  "keywords": [
    "soic",
    "investing",
    "tvgp",
    "valuation",
    "knowledge-base"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "markdown-it-mathjax3": "^4.3.2",
    "vitepress": "^1.6.3"
  }
}
